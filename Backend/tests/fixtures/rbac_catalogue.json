      "key": "platform.role.update",
      "owner": "platform",
      "scope_kind": "organization",
      "sensitivity": "privileged",
      "delegable_to_org_roles": true,
      "continuity": false,
      "status": "active",
      "reason": "RBAC governance. Replaces the legacy roles:update."
