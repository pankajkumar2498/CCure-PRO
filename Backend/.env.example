# =========================================================================
# CCure Audit PRO - Environment Variable Configuration
# =========================================================================
# Copy this file to '.env' and adjust the values before deploying.
# DO NOT commit the real '.env' file to version control.

# ── Application Environment ──────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO

# ── Initial Admin Setup ────────────────────────────────────────────────
# These credentials are only used during the initial startup when the
# database is completely empty. They will seed the first Superadmin.
#
# Left deliberately unset. A default committed here is a superadmin password
# known to everyone with the repository, on every deployment whose operator
# did not think to change it. Absent, no admin is seeded and startup says so.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# ── Security & Authentication ──────────────────────────────────────────
# JWT Secret Key - MUST be a long, cryptographically random string in prod.
# e.g. generate via: openssl rand -hex 32
JWT_SECRET_KEY=your_super_secret_jwt_key_here
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=7
REFRESH_COOKIE_NAME=ccure_refresh_token

# ── Database Configuration (PostgreSQL) ────────────────────────────────
POSTGRES_USER=ccure_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ccure_test
# For host-level workers connecting to the local docker-compose PostgreSQL container
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5432/${POSTGRES_DB}

# ── Vulnerability Intelligence Database ────────────────────────────────
VULN_DB_HOST=127.0.0.1
VULN_DB_PORT=5432
VULN_DB_NAME=vuln_intel
VULN_DB_USER=admin
VULN_DB_PASSWORD=change_me

# ── Task Queue (Redis/Celery) ──────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
SCANNER_WORKER_CONCURRENCY=20

# ── Scanner Engine Limits ──────────────────────────────────────────────
NMAP_TIMEOUT=300
NMAP_THREADS=20
MAX_NMAP_PROCESSES=20
NMAP_PROCESS_WAIT_TIMEOUT=900

# ── Frontend Configuration ─────────────────────────────────────────────
# The base URL where the backend API is hosted. Used by frontend.
VITE_API_BASE_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# ── Client IP resolution ───────────────────────────────────────────────
# Which hops are allowed to *speak about* the client address via
# X-Forwarded-For / X-Real-IP. This is a security control, not a logging
# convenience: the resolved address is the rate-limiting bucket key and the
# address written to the audit trail.
#
# List the reverse proxies themselves and nothing else. This default names
# loopback and Docker's bridge pool, which is what host nginx looks like from
# inside the API container.
#
# It previously included 10.0.0.0/8 and 192.168.0.0/16. On a deployment whose
# clients live at 10.180.6.0/24 that classified every real client as a proxy
# entitled to declare somebody else's address. Do not put a user network here.
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# ── Rate limiting ──────────────────────────────────────────────────────
# Per-endpoint limits are declared in code on the routes that need them
# (login, register, password recovery, OTP, scan dispatch). These cover what
# a decorator cannot.

# Baseline ceiling per client IP for every route carrying no explicit limit.
# Deliberately generous — a backstop so no route is entirely unbounded, not a
# usability tax. Sized per IP, and an office behind one NAT address shares the
# bucket. Empty string disables it.
API_DEFAULT_RATE_LIMIT=600/minute

# Paths the baseline never applies to. Matched exactly unless the entry ends
# in "*", which makes the text before it a prefix. "/" is the health endpoint,
# and it has to be exact — as a prefix it would exempt the whole application.
API_RATE_LIMIT_EXEMPT_PATHS=/,/docs*,/redoc*,/openapi.json

# What rate limiting does when Redis is unreachable. With this set, limits are
# enforced from process memory for the duration — degraded (the window is per
# worker process, and this limit applies in place of the per-route ones) but
# never absent. Empty restores the old behaviour, where a storage failure made
# every limited endpoint answer 500.
RATE_LIMIT_MEMORY_FALLBACK=20/minute

# Password-recovery anti-automation. The first bounds submissions to
# /auth/reset-password per IP and counts failures only. The second bounds how
# often one *account* can be sent a reset link, because the per-IP limit does
# nothing about a caller who rotates addresses and the mail goes to an address
# the caller names. 0 disables either.
PASSWORD_RESET_IP_HOURLY_LIMIT=20
PASSWORD_RESET_ACCOUNT_HOURLY_LIMIT=5

# ── Session retention ──────────────────────────────────────────────────────
# How long an *expired* refresh-token session row is kept before the daily
# sweep removes it. Not the token lifetime (7 days) — this is how long the
# record survives after it stops being usable.
#
# The table gains a row per login and another per rotation, which with
# 30-minute access tokens is ~48 rows a day per signed-in session, and nothing
# used to delete any of them. Revoked-but-recent rows are deliberately kept:
# the revocation is the audit record of a device being signed out. 0 disables.
REFRESH_SESSION_RETENTION_DAYS=90

# ── SMTP Configuration ─────────────────────────────────────────────────
# SMTP settings for outgoing emails (e.g. password recovery).
# For development, you can use Maildev or MailHog (default port 1025).
#
# WARNING: port 1025 is the MailDev/MailHog default and these defaults are
# development values. A production deployment that leaves them in place
# silently drops every verification link, password reset and password-change
# notice — the security controls that depend on mail all fail open and quiet.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=False
SMTP_FROM_EMAIL=no-reply@ccureaudit.pro

# ── Account lifecycle gates ────────────────────────────────────────────
# Self-service registration. Off by default: POST /admin/users is the
# supported onboarding path. When off, /auth/register, /auth/check-email,
# /auth/check-username and /auth/resend-verification all return 404.
#
# With it on, a new account is created unverified, inactive and unapproved
# with the read-only `viewer` role, and POST /auth/register returns 202 with
# no tokens. Sign-in needs BOTH a confirmed mailbox and an administrator
# approval (POST /admin/users/{id}/approve).
ALLOW_SELF_REGISTRATION=False

# Skip the administrator approval step, so a verified mailbox alone enables
# sign-in. Only sensible when registration is restricted some other way
# (invite-only front door, network ACL). Leave False otherwise: email
# verification proves control of a mailbox, not that the account should exist.
SELF_REGISTRATION_AUTO_APPROVE=False

# Verification link lifetime, and how long an account that never verified is
# retained before ccure.tasks.purge_stale_unverified_accounts deletes it.
EMAIL_VERIFICATION_TTL_HOURS=24
UNVERIFIED_ACCOUNT_TTL_DAYS=7

# How long an account that verified its mailbox but was never approved is kept.
# Separate from the setting above and NOT redundant with it: that task filters
# is_verified=False, and a throwaway-inbox registrant does click the
# verification link — so without this the approval queue only ever grows.
UNAPPROVED_ACCOUNT_TTL_DAYS=30

# ── Compliance frameworks offered by this installation ─────────────────
# Comma-separated framework ids. Thirteen catalogues ship and are all seeded;
# only the ids listed here are offered in the workspace, scannable, reportable
# or installable. Everything else is *parked* — still seeded, still the target
# of ISO's and NIST's crosswalks, simply not on. Unset uses the two frameworks
# that are finished to production standard.
#
# Parking is never a data decision: nothing is deleted, and re-enabling one is
# this line plus `python -m scripts.set_active_frameworks --apply`. Removing a
# seed file instead would make main.py's bootstrap re-seed on every start
# forever, because its condition names all thirteen.
# COMPLIANCE_ACTIVE_FRAMEWORKS=cfw_iso27001_2022,cfw_nist_csf_v2

# ── Disposable / throwaway email screening ─────────────────────────────
# off     — no screening at all
# flag    — verdicts computed and shown in the approval queue, nothing refused
# enforce — a confirmed-disposable domain is refused at account creation
#
# Start on `flag` for a week if you want evidence before enforcing; both modes
# record the same verdict, so the only difference is whether signup stops.
EMAIL_DOMAIN_GUARD_MODE=enforce

# How long the rules and blocklist corpus (~75k rows) are cached per process.
EMAIL_DOMAIN_CACHE_TTL_SECONDS=300

# The deferred half: MX presence and RDAP domain age, run on a worker after the
# account is committed. These only ever raise a flag. Set False in an air-gapped
# deployment — the blocklist half keeps working without any outbound access.
EMAIL_RISK_ENRICHMENT_ENABLED=True
EMAIL_RISK_DNS_TIMEOUT=3
EMAIL_RISK_RDAP_TIMEOUT=5

# Domains younger than this are flagged, never blocked. A throwaway domain that
# reached this deployment was 17 months old, and real companies register a
# domain the week they incorporate — so this cannot be a refusal rule.
EMAIL_RISK_MIN_DOMAIN_AGE_DAYS=90

# Registration volume ceilings, on top of the 3/minute limiter.
#
# Note the daily cap is per client IP. Everyone behind one corporate NAT shares
# it, so raise it if you expect a batch of colleagues to sign up on the same day
# from one office. 0 disables.
REGISTRATION_DAILY_IP_LIMIT=10

# Refuse new registrations once this many accounts are awaiting approval. The
# queue is an administrator's attention and it is finite. 0 disables.
PENDING_APPROVAL_QUEUE_LIMIT=200

# Sync safety for scripts/security/sync_disposable_domains.py. A source that
# returns fewer domains than the minimum is rejected rather than merged: an
# error page parses to zero and would silently empty the corpus, which looks
# exactly like a clean run in the logs.
DISPOSABLE_SYNC_MIN_ROWS_PER_SOURCE=500
DISPOSABLE_RETIRE_AFTER_MISSES=3

# ── Scan authorisation ─────────────────────────────────────────────────
# When True, an organisation with no configured scan scope
# (organizations.scan_scope_cidrs IS NULL) cannot scan at all, instead of
# falling back to unrestricted.
#
# Ships False so adding the column does not stop existing organisations from
# scanning. Set a scope on every org via
#   PUT /admin/organizations/{org_id}/scan-scope  {"cidrs": ["10.180.6.0/24"]}
# then set this True. Until you do, an org with no scope can scan any routable
# address — which is what this control exists to prevent.
REQUIRE_SCAN_SCOPE=False

# ─────────────────────────────────────────────────────────────────────────────
# Vulnerability feeds
#
# None of these are required for the application to start. They are listed
# because their defaults are machine-specific, or because their absence
# disables a capability quietly rather than loudly.
#
# Note Backend/.env is the file config.py loads. The repository-root .env is
# for docker-compose only, and a value placed there is silently ignored by
# every Python script here.
#
# Windows paths are written with forward slashes on purpose: several .env
# parsers treat a backslash followed by n, t or r as an escape sequence, so a
# path written with backslashes is truncated at that point and the value the
# application receives is a prefix plus a stray newline.
# ─────────────────────────────────────────────────────────────────────────────

# Where feed downloads are cached. One root for every feed; the per-feed
# variables override it individually. Budget ~2 GB for the archives. The
# databases they populate are far larger (vuln_intel reaches ~10 GB once every
# feed has run) and live wherever PostgreSQL's data directory points.
# Default: <repo>/feeds
#CCURE_FEED_DIR=D:/ccure-feeds
#OSV_STAGING_DIR=
#MSRC_STAGING_DIR=
#EXPLOIT_STAGING_DIR=
#CSAF_STAGING_DIR=

# NVD works unauthenticated but is heavily rate limited; a free key raises it.
#NVD_API_KEY=

# VulnCheck KEV — 5,117 exploited-in-the-wild CVEs against CISA KEV's 1,647.
# Free tier token from vulncheck.com. Without it sync_vulncheck.py exits 2 and
# the broader exploitation signal is simply absent.
#VULNCHECK_API_TOKEN=

# Nuclei active template verification. Findings it produces are proven by
# probe rather than inferred from a version, so they carry the highest
# confidence the system awards. Absent binary = the plugin logs that it is
# unavailable and returns nothing; scans still run.
#   install:   https://github.com/projectdiscovery/nuclei/releases
#   templates: nuclei -update-templates -ud <dir>
# Defaults: "nuclei" on PATH, and ~/nuclei-templates
#NUCLEI_BINARY=D:/ccure-tools/nuclei/nuclei.exe
#NUCLEI_TEMPLATES=D:/ccure-tools/nuclei-templates

# The full corpus is ~13,500 templates and exceeds ten minutes against one
# host; most of the excess is `info`, which is technology detection rather
# than vulnerability.
#NUCLEI_SEVERITIES=critical,high,medium
#NUCLEI_TIMEOUT=900
#NUCLEI_RATE_LIMIT=150
#NUCLEI_CONCURRENCY=50

# Nuclei scan profiles — Phase 10. A scan runs FAST, STANDARD or DEEP (chosen
# per scan via nuclei_profile / scan_depth). STANDARD reuses NUCLEI_CONCURRENCY
# and NUCLEI_TIMEOUT above, so it does not regress. FAST trades coverage for
# speed; DEEP's timeout and concurrency are separately tunable.
#NUCLEI_CONCURRENCY_FAST=75
#NUCLEI_TIMEOUT_FAST=1800
#NUCLEI_CONCURRENCY_DEEP=40
#NUCLEI_TIMEOUT_DEEP=14400
# Safety exclusions applied to EVERY profile by default (this scans production
# and OT hosts). Only change these deliberately.
#NUCLEI_EXCLUDE_TAGS=dos,fuzz,intrusive,brute-force
#NUCLEI_INCLUDE_DANGEROUS_TAGS=False

# ─── File upload guards ──────────────────────────────────────────────────────
# Two endpoints accept a file: POST /compliance/controls/{id}/evidence and
# POST /assets/import-amt. Both cap the read, verify the payload's magic bytes
# against the type the client declared, and build Content-Disposition through
# core/upload_guard.py. None of that needs configuration; what follows does.

# Where evidence documents are written. Tenant-scoped subdirectories are
# created under it.
#
# **The default is a development default.** /app is the API container's mount
# of ./Backend, so leaving this unset writes real tenant evidence into the
# source tree — it is gitignored, but it still accumulates there and is lost on
# a rebuild. A production deployment should point this at a dedicated,
# backed-up volume outside the repository.
#COMPLIANCE_EVIDENCE_DIR=/var/lib/ccure/compliance_evidence

# Per-tenant evidence storage ceiling, in bytes. The 25 MB per-file cap bounds
# one request; this bounds the loop. Default 2 GiB.
#COMPLIANCE_EVIDENCE_TENANT_QUOTA_BYTES=2147483648

# Malware scanning for uploaded evidence, via clamd's INSTREAM protocol.
# Unset = no scan, and the API says so in the upload response's `malware_scan`
# field rather than implying one happened.
#
#   docker compose --profile av up -d clamav
#
#CLAMAV_HOST=clamav
#CLAMAV_PORT=3310
#CLAMAV_TIMEOUT=30

# Whether a scan is mandatory. **Defaults to on whenever CLAMAV_HOST is set** —
# deploying a scanner is the act of requiring it. With it on, an unreachable or
# unintelligible scanner refuses the upload with HTTP 503; the file is not
# accused of anything, so it does not share a status with a detection (400).
#
# Set False to opt into fail-open deliberately, which is reasonable while clamd
# is still being brought up: an unreachable scanner then logs loudly and the
# upload is stored with `malware_scan: scanner_unavailable`.
#
# Only an explicit "OK" from clamd is ever reported as clean. A timeout, a
# dropped connection, a reply with no NUL terminator, an ERROR or anything
# unrecognised is `scanner_unavailable` — never `clean`. A scanner failure
# reported as clean is worse than no scanner, because it launders an unscanned
# file into an audit trail that says it was checked.
#UPLOAD_AV_REQUIRED=True

# ─────────────────────────────────────────────────────────────────────────────
# Out-of-band (OAST) blind detection — Phase 9
# ─────────────────────────────────────────────────────────────────────────────
# Blind SSRF, out-of-band command injection and blind XXE leave no trace in the
# HTTP response; the only evidence is a callback the payload causes the target
# to make to a collaborator the scanner controls.
#
# CCure's own active OOB probes run ONLY against a self-hosted collaborator
# configured here — never the public interact.sh — so they add no outbound
# internet dependency and never ship a target callback to a third party. With
# nothing configured the scan skips them and records the blind classes as
# actively unassessed (nuclei's own interactsh handling is separate, above).
#
# Point OAST_SERVER at a self-hosted collaborator's base URL and/or set the DNS
# zone. Either OAST_DOMAIN or OAST_HTTP_URL is enough to enable active probing.
#OAST_ENABLED=True
#OAST_ACTIVE_PROBES=True
#OAST_SERVER=http://oast.ccure.internal:8888
#OAST_DOMAIN=oast.ccure.internal
#OAST_HTTP_URL=http://oast.ccure.internal:8888
#OAST_TOKEN=                     # bearer for the collaborator's poll endpoint
#OAST_POLL_TIMEOUT_S=30
#OAST_POLL_INTERVAL_S=2
#OAST_RATE_LIMIT=5
#OAST_MAX_TARGETS=25
# Ports for a collaborator CCure runs itself (no-egress deployments):
#OAST_RECEIVER_HTTP_PORT=8888
#OAST_RECEIVER_DNS_PORT=53

# ─────────────────────────────────────────────────────────────────────────────
# Web crawler performance & adaptive content discovery — Phase 11
# ─────────────────────────────────────────────────────────────────────────────
# The crawler runs a bounded-concurrency BFS: up to CRAWL_CONCURRENCY pages at
# once (each in its own browser page, so memory is bounded), with a shared
# navigation rate ceiling so it fills the pipeline without exceeding the
# target's tolerance. Concurrency does not change what is found.
#CRAWL_CONCURRENCY=3
#CRAWL_RATE_LIMIT=10             # navigation starts/sec, shared across workers
#MAX_CRAWL_URLS=500
#MAX_CRAWL_DEPTH=5
#PLAYWRIGHT_TIMEOUT=60000        # per-page nav ceiling (ms)
#CRAWL_SETTLE_TIMEOUT=5000       # post-load settle budget (ms)

# ffuf content discovery scales with how much the crawl already mapped, so a
# tiny app does not spend ~8 minutes on a full wordlist. The small tier uses a
# curated high-value list that still covers every sensitive-file check; the tier
# chosen is recorded on the scan so coverage is never reduced silently.
#FFUF_WORDLIST=/opt/wordlists/common.txt          # standard/medium tier
#FFUF_WORDLIST_SMALL=<repo>/Backend/data/wordlists/web_discovery_small.txt
#FFUF_WORDLIST_DEEP=                               # empty → falls back to FFUF_WORDLIST
#FFUF_SMALL_MAX_ENDPOINTS=5      # crawl endpoints ≤ this → small tier
#FFUF_MEDIUM_MAX_ENDPOINTS=50    # ≤ this → standard tier; more → deep
#FFUF_MAX_WORDS_SMALL=0          # 0 = whole (small) list
#FFUF_MAX_WORDS_STANDARD=0
#FFUF_MAX_WORDS_DEEP=0

# ─────────────────────────────────────────────────────────────────────────────
# Global web-scan timeout — Phase 12
# ─────────────────────────────────────────────────────────────────────────────
# A single ceiling on total wall-clock time for a web scan, beginning when the
# scan actually starts executing (RECON), enforced actively (running work stops
# and the scan is settled terminal with findings preserved) and by the
# stall-reaper backstop. The per-phase watchdog and queue timeout remain. 0
# disables the global cap (per-phase limits still apply).
#WEB_SCAN_TIMEOUT=14400          # seconds (4 hours)
#WEB_SCAN_QUEUE_TIMEOUT_MINUTES=15
