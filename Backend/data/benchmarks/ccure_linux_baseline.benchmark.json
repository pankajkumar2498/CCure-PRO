{
  "benchmark": {
    "code": "CCURE_LINUX_BASELINE",
    "licence": "CCURE Audit PRO original content. Distributed with the product under its own licence. This is not a CIS Benchmark and must not be presented as one.",
    "name": "CCURE Linux Hardening Baseline",
    "notes": "Generated by scripts/benchmarks/build_baseline_packs.py from the built-in rules in core/config_audit/builtin/. Not a CIS Benchmark. Crosswalk targets are CIS Critical Security Controls v8.1 safeguards.",
    "platform": "linux",
    "profiles": [
      {
        "id": "L1",
        "title": "Level 1 — settings a general-purpose host should meet"
      },
      {
        "id": "L2",
        "title": "Level 2 — defence in depth, may affect usability"
      }
    ],
    "publisher": "CCURE Audit PRO",
    "version": "1.0.0"
  },
  "controls": [
    {
      "assessment": "automated",
      "check": {
        "absent": "manual_review",
        "check_id": "ccure.linux.password.max_age",
        "check_type": "security_policy",
        "collect": {
          "setting": "pass_max_days"
        },
        "config_check": true,
        "domain": "host_configuration",
        "expected": 365,
        "expected_description": "at most 365 days",
        "intrusive": false,
        "operator": "lte",
        "platforms": [
          "linux"
        ],
        "qod": 95,
        "requires_credentials": true,
        "tags": [
          "linux",
          "identity"
        ]
      },
      "control_id": "1.1",
      "crosswalk": [
        "CIS_V8_1:5.2"
      ],
      "description": "PASS_MAX_DAYS from /etc/login.defs.",
      "profiles": [
        "L1"
      ],
      "rationale": "An unbounded password lifetime means a credential compromised years ago is still valid today.",
      "references": [],
      "remediation": "Set PASS_MAX_DAYS in /etc/login.defs and apply with chage.",
      "section": "1 Account Policies",
      "severity": "low",
      "title": "Password maximum age is set"
    },
    {
      "assessment": "automated",
      "check": {
        "absent": "manual_review",
        "check_id": "ccure.linux.password.min_length",
        "check_type": "security_policy",
        "collect": {
          "setting": "minlen"
        },
        "config_check": true,
        "domain": "host_configuration",
        "expected": 14,
        "expected_description": "at least 14 characters",
        "intrusive": false,
        "operator": "gte",
        "platforms": [
          "linux"
        ],
        "qod": 95,
        "requires_credentials": true,
        "tags": [
          "linux",
          "identity"
        ]
      },
      "control_id": "1.2",
      "crosswalk": [
        "CIS_V8_1:5.2"
      ],
      "description": "minlen from /etc/security/pwquality.conf.",
      "profiles": [
        "L1"
      ],
      "rationale": "Length is the property that most directly resists offline cracking of a recovered hash.",
      "references": [],
      "remediation": "Set 'minlen = 14' in /etc/security/pwquality.conf.",
      "section": "1 Account Policies",
      "severity": "medium",
      "title": "Password quality enforces a minimum length"
    },
    {
      "assessment": "automated",
      "check": {
        "absent": "manual_review",
        "check_id": "ccure.linux.ssh.permit_root_login",
        "check_type": "config_file",
        "collect": {
          "key": "PermitRootLogin",
          "path": "/etc/ssh/sshd_config",
          "separator": ""
        },
        "config_check": true,
        "domain": "host_configuration",
        "expected": [
          "no",
          "prohibit-password",
          "without-password",
          "forced-commands-only"
        ],
        "expected_description": "no, prohibit-password or forced-commands-only",
        "intrusive": false,
        "operator": "in",
        "platforms": [
          "linux"
        ],
        "qod": 95,
        "requires_credentials": true,
        "tags": [
          "linux",
          "remote_access"
        ]
      },
      "control_id": "2.1",
      "crosswalk": [
        "CIS_V8_1:5.4"
      ],
      "description": "Whether the SSH daemon accepts a direct root login with a password.",
      "profiles": [
        "L1"
      ],
      "rationale": "Direct root login removes the accountability of a named account and gives a single guessed password full control of the host.",
      "references": [],
      "remediation": "Set 'PermitRootLogin prohibit-password' (or 'no') in /etc/ssh/sshd_config and reload sshd.",
      "section": "2 SSH Server",
      "severity": "high",
      "title": "SSH does not permit password-based root login"
    },
    {
      "assessment": "automated",
      "check": {
        "absent": "manual_review",
        "check_id": "ccure.linux.ssh.password_authentication",
        "check_type": "config_file",
        "collect": {
          "key": "PasswordAuthentication",
          "path": "/etc/ssh/sshd_config",
          "separator": ""
        },
        "config_check": true,
        "domain": "host_configuration",
        "expected_description": "no",
        "intrusive": false,
        "operator": "is_false",
        "platforms": [
          "linux"
        ],
        "qod": 95,
        "requires_credentials": true,
        "tags": [
          "linux",
          "remote_access"
        ]
      },
      "control_id": "2.2",
      "crosswalk": [
        "CIS_V8_1:5.2"
      ],
      "description": "Whether the SSH daemon accepts passwords as well as keys.",
      "profiles": [
        "L2"
      ],
      "rationale": "Key authentication is not guessable; leaving passwords enabled keeps the host exposed to spraying regardless of key hygiene.",
      "references": [],
      "remediation": "Set 'PasswordAuthentication no' once key access is confirmed working for every account that needs it.",
      "section": "2 SSH Server",
      "severity": "medium",
      "title": "SSH password authentication is disabled"
    },
    {
      "assessment": "automated",
      "check": {
        "absent": "manual_review",
        "check_id": "ccure.linux.ssh.max_auth_tries",
        "check_type": "config_file",
        "collect": {
          "key": "MaxAuthTries",
          "path": "/etc/ssh/sshd_config",
          "separator": ""
        },
        "config_check": true,
        "domain": "host_configuration",
        "expected": 4,
        "expected_description": "at most 4",
        "intrusive": false,
        "operator": "lte",
        "platforms": [
          "linux"
        ],
        "qod": 95,
        "requires_credentials": true,
        "tags": [
          "linux",
          "remote_access"
        ]
      },
      "control_id": "2.3",
      "crosswalk": [
        "CIS_V8_1:5.2"
      ],
      "description": "Failed attempts allowed within a single SSH connection.",
      "profiles": [
        "L1"
      ],
      "rationale": "A high limit lets one connection carry many guesses, which costs an attacker far less than opening a connection per attempt.",
      "references": [],
      "remediation": "Set 'MaxAuthTries 4' in /etc/ssh/sshd_config.",
      "section": "2 SSH Server",
      "severity": "low",
      "title": "SSH limits authentication attempts per connection"
    },
    {
      "assessment": "automated",
      "check": {
        "absent": "fail",
        "check_id": "ccure.linux.passwd.permissions",
        "check_type": "permission",
        "collect": {
          "attribute": "mode",
          "path": "/etc/passwd"
        },
        "config_check": true,
        "domain": "host_configuration",
        "expected": [
          "644",
          "0644",
          "444",
          "0444"
        ],
        "expected_description": "0644 or stricter",
        "intrusive": false,
        "operator": "in",
        "platforms": [
          "linux"
        ],
        "qod": 95,
        "requires_credentials": true,
        "tags": [
          "linux",
          "filesystem"
        ]
      },
      "control_id": "3.1",
      "crosswalk": [
        "CIS_V8_1:3.3"
      ],
      "description": "Filesystem mode of the local account database.",
      "profiles": [
        "L1"
      ],
      "rationale": "A writable /etc/passwd allows an unprivileged user to add an account, or to blank the password field of an existing one.",
      "references": [],
      "remediation": "chmod 0644 /etc/passwd && chown root:root /etc/passwd",
      "section": "3 Filesystem",
      "severity": "high",
      "title": "/etc/passwd is not group- or world-writable"
    },
    {
      "assessment": "automated",
      "check": {
        "absent": "fail",
        "check_id": "ccure.linux.shadow.permissions",
        "check_type": "permission",
        "collect": {
          "attribute": "mode",
          "path": "/etc/shadow"
        },
        "config_check": true,
        "domain": "host_configuration",
        "expected": [
          "0",
          "000",
          "400",
          "0400",
          "600",
          "0600",
          "640",
          "0640"
        ],
        "expected_description": "0640 or stricter",
        "intrusive": false,
        "operator": "in",
        "platforms": [
          "linux"
        ],
        "qod": 95,
        "requires_credentials": true,
        "tags": [
          "linux",
          "filesystem"
        ]
      },
      "control_id": "3.2",
      "crosswalk": [
        "CIS_V8_1:3.3"
      ],
      "description": "Filesystem mode of the local password hash store.",
      "profiles": [
        "L1"
      ],
      "rationale": "A readable /etc/shadow hands every local user the hashes to crack offline, at their own pace and without triggering any lockout.",
      "references": [],
      "remediation": "chmod 0640 /etc/shadow && chown root:shadow /etc/shadow",
      "section": "3 Filesystem",
      "severity": "critical",
      "title": "/etc/shadow is not readable by unprivileged users"
    },
    {
      "assessment": "automated",
      "check": {
        "absent": "not_applicable",
        "check_id": "ccure.linux.cron.permissions",
        "check_type": "permission",
        "collect": {
          "attribute": "mode",
          "path": "/etc/crontab"
        },
        "config_check": true,
        "domain": "host_configuration",
        "expected": [
          "600",
          "0600",
          "644",
          "0644"
        ],
        "expected_description": "0644 or stricter",
        "intrusive": false,
        "operator": "in",
        "platforms": [
          "linux"
        ],
        "qod": 95,
        "requires_credentials": true,
        "tags": [
          "linux",
          "filesystem"
        ]
      },
      "control_id": "3.3",
      "crosswalk": [
        "CIS_V8_1:3.3"
      ],
      "description": "Filesystem mode of the system crontab.",
      "profiles": [
        "L1"
      ],
      "rationale": "A writable system crontab is a direct path to code execution as root at the next scheduled run.",
      "references": [],
      "remediation": "chmod 0644 /etc/crontab && chown root:root /etc/crontab",
      "section": "3 Filesystem",
      "severity": "medium",
      "title": "/etc/crontab is not writable by unprivileged users"
    },
    {
      "assessment": "automated",
      "check": {
        "absent": "pass",
        "check_id": "ccure.linux.telnet.port_closed",
        "check_type": "port",
        "collect": {
          "port": 23
        },
        "config_check": true,
        "domain": "host_configuration",
        "expected": "listening",
        "intrusive": false,
        "operator": "not_equals",
        "platforms": [
          "linux"
        ],
        "qod": 95,
        "requires_credentials": true,
        "tags": [
          "linux",
          "protocol"
        ]
      },
      "control_id": "4.1",
      "crosswalk": [
        "CIS_V8_1:4.8"
      ],
      "description": "TCP 23, the telnet service port.",
      "profiles": [
        "L1"
      ],
      "rationale": "Telnet transmits credentials and session content in clear text on a network where anyone on the path can read them.",
      "references": [],
      "remediation": "Remove the telnet server package and use SSH.",
      "section": "4 Protocols",
      "severity": "high",
      "title": "No telnet daemon is listening"
    },
    {
      "assessment": "automated",
      "check": {
        "absent": "fail",
        "check_id": "ccure.linux.auditd.running",
        "check_type": "service",
        "collect": {
          "attribute": "status",
          "name": "auditd"
        },
        "config_check": true,
        "domain": "host_configuration",
        "expected": "active",
        "intrusive": false,
        "operator": "equals",
        "platforms": [
          "linux"
        ],
        "qod": 95,
        "requires_credentials": true,
        "tags": [
          "linux",
          "logging"
        ]
      },
      "control_id": "5.1",
      "crosswalk": [
        "CIS_V8_1:8.2"
      ],
      "description": "auditd records kernel audit events to disk.",
      "profiles": [
        "L1"
      ],
      "rationale": "Without it there is no local record of privilege use or of changes to the files these other rules check, so an incident cannot be reconstructed afterwards.",
      "references": [],
      "remediation": "Install and enable auditd, then define an audit ruleset.",
      "section": "5 Logging",
      "severity": "medium",
      "title": "The audit daemon is running"
    },
    {
      "assessment": "unimplemented",
      "control_id": "6.1",
      "crosswalk": [
        "CIS_V8_1:8.5"
      ],
      "description": "The audit daemon running is necessary but not sufficient; it records only what its ruleset tells it to.",
      "profiles": [
        "L2"
      ],
      "rationale": "An auditd with no rules produces an empty trail while appearing healthy to every check that looks only at the service state.",
      "remediation": "Install an audit ruleset covering execve of privileged binaries and reload it with augenrules --load.",
      "section": "6 Logging",
      "severity": "medium",
      "title": "auditd rules cover privileged command execution",
      "unimplemented_reason": "requires parsing and semantically comparing an auditd ruleset, which the command collector returns as raw text."
    }
  ]
}
