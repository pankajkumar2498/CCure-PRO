# =========================================================================
# docker-compose environment. Copy to '.env' and fill in every value.
#
# This file is TRACKED. Nothing real belongs in it — not a password, not a
# key, not a token. A value committed here is public to everyone who has
# ever cloned the repository, and removing it later does not remove it from
# the history.
#
# Note this is the file docker-compose substitutes ${VAR} from. Backend/.env
# is a separate file that config.py loads for the API and the host worker.
# A secret has to be in both to reach both.
# =========================================================================

# ── Database Configuration ────────────────────────────────────────────────
POSTGRES_USER=ccure_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ccure_test

# Database Host Routing:
# - Leave blank/commented out to use the local containerized PostgreSQL DB (Default for new developers)
# - Set to 'host.docker.internal' to connect to a native PostgreSQL instance running on the Windows host
DATABASE_HOST=

# Database Port Binding on Windows Host:
# - Set to '5432' if you do not have a native PostgreSQL running on Windows (Default for containerized DB)
# - Set to '5433' if you run a native PostgreSQL service on port 5432 to prevent port collisions
POSTGRES_PORT_BINDING=5432

# ── Network Configuration ─────────────────────────────────────────────────
SERVER_IP=10.180.6.14
VITE_API_BASE_URL=/api
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://10.180.6.14:3000,http://localhost:3200,http://127.0.0.1:3200,http://10.180.6.14:3200,http://10.180.6.14,http://10.180.6.14:80
GATEWAY_PORT=8080

# ── Authentication ────────────────────────────────────────────────────────
# This key signs every access token. Anyone holding it can mint a valid token
# for any user, including a superadmin, so it must be generated per
# deployment and never committed.
# Generate a new one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=generate_me_see_comment_above

# ── Application ───────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO

# Vulnerability intelligence database
# - Set to 'db' to connect to the local containerized DB
# - Set to 'host.docker.internal' to connect to a native PostgreSQL instance running on the Windows host
VULN_DB_HOST=db
VULN_DB_PORT=5432
VULN_DB_NAME=vuln_intel
VULN_DB_USER=admin
VULN_DB_PASSWORD=change_me

# ── Scanning ──────────────────────────────────────────────────────────────
NMAP_TIMEOUT=300
NMAP_THREADS=4

# SMTP Configuration
# For Gmail this is an app password, not the account password. It is a live
# send-as credential for the account named below: mail sent with it arrives
# from a genuine address, which is exactly what makes a leaked one useful to
# somebody else.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=change_me
SMTP_SECURE=True
SMTP_FROM_EMAIL=no-reply@example.com
FRONTEND_URL=http://10.180.6.14

# Celery local synchronous execution for easy testing
CELERY_TASK_ALWAYS_EAGER=False

# ── Token signing keys (Phase 9.3) ────────────────────────────────────────
# Host directory holding keyset.json and the private key files, mounted
# read-only into the api container only. Keep it OUTSIDE the repository and
# inside a directory other host accounts cannot traverse: the key files are
# owned by uid 1000 (the container user), which may be a different person's
# account on the host. Create and rotate it with
# Backend/scripts/security/manage_token_keys.py; see
# docs/architecture/PHASE9_TOKENS_AND_SERVICE_IDENTITIES.md.
CCURE_TOKEN_KEYS_HOST_DIR=/home/<deploy-user>/ccure-keys

# Algorithm for newly issued tokens (Phase 9.4): ES256 (default) or HS256.
# ES256 signs with the keyset's `active` key and the api refuses to start
# without one. HS256 is the rollback: it issues the pre-9.4 token, and tokens
# already issued ES256 stay valid. Keep HS256 until a key has been promoted
# to active (manage_token_keys.py set-state <kid> active) and escrowed.
CCURE_TOKEN_SIGNING_ALG=HS256
