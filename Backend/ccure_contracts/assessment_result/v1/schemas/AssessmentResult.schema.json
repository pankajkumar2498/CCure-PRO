    "CredentialOutcome": {
      "description": "The result of the authenticated session a credentialed assessment needs.\n\nThe four failure members are distinct because each sends the operator to a\ndifferent fix: a wrong password, an account without rights, a host that\ndid not answer, and anything else. ``FAILED_UNCLASSIFIED`` is used where\nthe transport could not tell which.",
      "enum": [
        "SUCCEEDED",
        "AUTHENTICATION_REJECTED",
        "INSUFFICIENT_PRIVILEGE",
        "UNREACHABLE",
        "FAILED_UNCLASSIFIED",
        "NOT_ATTEMPTED"
      ],
      "title": "CredentialOutcome",
      "type": "string"
    },
    "DefinitionType": {
      "description": "What kind of catalogue entry a finding is an instance of.",
      "enum": [
        "cve",
        "config_check",
        "plugin_check",
        "privilege_check"
      ],
      "title": "DefinitionType",
      "type": "string"
    },
    "MethodOutcome": {
      "description": "What happened to one method on one asset.\n\n``unknown`` exists because Audit does not yet record a structured outcome\nfor every method on every path. It is the honest answer where the record\nis missing, and it must never be read as ``completed``.",
      "enum": [
        "completed",
        "partial",
        "failed",
        "not_run",
        "not_implemented",
        "unknown"
      ],
      "title": "MethodOutcome",
      "type": "string"
    },
    "Module": {
      "description": "The four CCure modules, plus the shared platform.",
      "enum": [
        "policy_pro",
        "audit",
        "rank",
        "ir",
        "platform"
      ],
      "title": "Module",
      "type": "string"
    },
    "ValueStatus": {
      "description": "Why a measured value is or is not present.",
      "enum": [
        "available",
        "not_implemented",
        "not_collected",
        "not_applicable"
      ],
      "title": "ValueStatus",
      "type": "string"
    }
  },
  "$id": "https://ccurepro.cdac.in/contracts/assessment_result/v1/AssessmentResult.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The message_id of the message that directly caused this one, if any.",
      "title": "Causation Id",
      "x-ccure-availability": "available",
      "x-ccure-owner": "producer"
    },
    "contract": {
      "const": "ccure.audit.assessment_result",
      "description": "Contract name.",
      "enum": [
        "ccure.audit.assessment_result"
      ],
      "title": "Contract",
      "type": "string",
      "x-ccure-availability": "available",
      "x-ccure-owner": "producer"
    },
    "correlation_id": {
      "description": "Ties together every message and log line caused by one originating request or event. Propagated unchanged from the message that caused this one; a new root starts a new id.",
      "maxLength": 400,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]*$",
      "title": "Correlation Id",
      "type": "string",
      "x-ccure-availability": "available",
      "x-ccure-owner": "producer"
    },
    "data": {
      "allOf": [
        {
          "$ref": "#/$defs/CcureAssessmentResultDataV1"
        }
      ],
      "description": "The result.",
      "x-ccure-availability": "available",
      "x-ccure-owner": "audit"
    },
    "message_id": {
      "description": "Unique per message and stable across retries of the same message. It is the idempotency key: a receiver that has seen it answers with its original result and does nothing else.",
      "format": "uuid",
      "title": "Message Id",
      "type": "string",
      "x-ccure-availability": "available",
      "x-ccure-owner": "producer"
    },
    "produced_at": {
      "description": "When the message was produced. RFC 3339, timezone required.",
      "format": "date-time",
      "title": "Produced At",
      "type": "string",
      "x-ccure-availability": "available",
      "x-ccure-owner": "producer"
    },
    "schema_version": {
      "description": "The contract's schema version, 1.<minor>. A minor increase only adds optional fields.",
      "pattern": "^1\\.(0|[1-9][0-9]*)$",
      "title": "Schema Version",
      "type": "string",
      "x-ccure-availability": "available",
      "x-ccure-owner": "producer"
    },
    "source": {
      "allOf": [
        {
          "$ref": "#/$defs/CcureSourceV1"
        }
      ],
      "description": "The producing module.",
      "x-ccure-availability": "available",
      "x-ccure-owner": "producer"
    },
    "tenant_id": {
      "description": "The organisation (platform tenant) the message belongs to. Checked against the tenant bound to the caller's service credential.",
      "maxLength": 400,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]*$",
      "title": "Tenant Id",
      "type": "string",
      "x-ccure-availability": "available",
      "x-ccure-owner": "platform"
    }
  },
  "required": [
    "contract",
    "schema_version",
    "message_id",
    "tenant_id",
    "source",
    "produced_at",
    "correlation_id",
    "data"
  ],
  "title": "CcureAssessmentResultV1",
  "type": "object",
  "x-ccure-schema-version": "1.0",
  "x-ccure-status": "draft"
}
