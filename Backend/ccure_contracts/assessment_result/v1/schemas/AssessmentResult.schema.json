            "7.3.8.8"
          ]
        },
        "reopen_rate": {
          "allOf": [
            {
              "$ref": "#/$defs/CcureMeasuredValueV1"
            }
          ],
          "description": "Percent of fixed findings that reappeared.",
          "x-ccure-availability": "not_implemented",
          "x-ccure-owner": "audit",
          "x-ccure-srs": [
            "7.3.8.7"
          ]
        },
        "sla_compliance_rate": {
          "allOf": [
            {
              "$ref": "#/$defs/CcureMeasuredValueV1"
            }
          ],
          "description": "Percent remediated within SLA.",
          "x-ccure-availability": "not_implemented",
          "x-ccure-owner": "audit",
          "x-ccure-srs": [
            "7.3.8.7"
          ]
        },
        "vulnerability_density": {
