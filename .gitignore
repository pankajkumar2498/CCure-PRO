# Dependency directories
node_modules/
jspm_packages/

# Build outputs
dist/
out/
build/
bin/
obj/

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.user

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
Backend/.env.test

# Logs
logs/
*.log

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg

# Pytest cache
.pytest_cache/
.coverage
htmlcov/

# Database files
*.db
*.sqlite
*.sqlite3
ccure_users.db

# Generated reports
reports/
test_reports/

# Test database files
test_*.db
test_User_DB*

# Backend test data
Backend/db/test_data/prod_data.sql
Backend/db/test_data/prod_full.dump
Backend/db/test_data/prod_schema.sql

# Type checking caches
.pytype/
.mypy_cache/
# Ruff writes its own .gitignore inside this directory, so the cache is
# ignored even without an entry here — until that generated file is not
# there, at which point thousands of cache files appear as untracked
# changes. Do not rely on a tool to ignore itself.
.ruff_cache/

# .md files
.agent/
.claude/

# docs/ binaries ignored, markdown tracked
docs/*.docx
docs/*.pdf
!docs/*.md
!docs/**/*.md

# pre-commit cache
.pre-commit-cache/

# Database dumps from scripts/backup_db.ps1
backups/
.env.bak*

# ── TLS material ────────────────────────────────────────────────────────────
# The internal root CA is public and safe to distribute, but it is
# deployment-specific: each installation runs its own CA, so committing one
# would ship a trust anchor that is wrong everywhere else. Generate it with
# scripts/tls/new_internal_ca.ps1 and copy the root here.
certs/*.crt
certs/*.key
# Private keys must never be committed under any name.
*.key
*.pem

# Test coverage artefact. CI generates it with `pytest --cov-report=xml`
# on every run, so a committed copy is stale the moment it lands.
coverage.xml
.coverage
htmlcov/
