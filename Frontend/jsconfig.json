{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shell/*": ["src/shell/*"],
      "@audit/*": ["src/modules/audit/*"],
      "@policy/*": ["src/modules/policy/*"],
      "@rank/*": ["src/modules/rank/*"],
      "@ir/*": ["src/modules/ir/*"]
    },
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "checkJs": false,
    "forceConsistentCasingInFileNames": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
