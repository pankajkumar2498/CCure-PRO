# DATABASE CONFIGURATION
# Dedicated test database - do not use for production
DATABASE_URL=postgresql://ccure_user:ccure_admin_2026@127.0.0.1:5432/ccure_test

# JWT Secret Key (different from production)
JWT_SECRET_KEY=test-secret-key-do-not-use-in-prod

# JWT Expiry Times
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=7

# NMAP Configuration
NMAP_TIMEOUT=300
NMAP_THREADS=4

# Logging Level
LOG_LEVEL=INFO

# Vulnerability intelligence database (same as production for tests)
VULN_DB_HOST=localhost
VULN_DB_PORT=5432
VULN_DB_NAME=vuln_intel
VULN_DB_USER=admin
VULN_DB_PASSWORD=root