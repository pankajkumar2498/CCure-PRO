# =========================================================================
# docker-compose environment. Copy to '.env' (next to docker-compose.yml),
# `chmod 600 .env`, and fill in every value marked REQUIRED.
#
# This file is TRACKED. Nothing real belongs in it — not a password, not a
# key, not a token. A value committed here is public to everyone who has
# ever cloned the repository, and removing it later does not remove it from
# the history.
#
# This is the only file the containers' configuration comes from. Compose
# substitutes these values into docker-compose.yml and passes each one to the
# services that use it. No container reads Backend/.env: api, worker,
# web-worker and beat all set SKIP_DOTENV_LOAD=1. Backend/.env is for scripts
# run on the host (feed syncs, operator tools) and for running the backend
# outside Docker. README.md, "Configure the environment", explains both files.
#
# Optional settings are listed commented out, with the default the code uses
# when they are unset. To change one, uncomment it and give it a value. Never
# leave one uncommented with an empty value: Compose then passes an empty
# string, which is not the default.
# =========================================================================

# Start the scanner workers (worker, web-worker) with the rest of the stack.
# Without it `docker compose up -d` starts no scanner and scans never run.
COMPOSE_PROFILES=container-scanner

# ── Database (PostgreSQL 18, the `db` service) ──────────────────────────────
# Application role and database. scripts/docker-postgres-init.sql creates the
# role NOSUPERUSER when the data volume is first initialised. REQUIRED.
POSTGRES_USER=ccure_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ccure_db

# The bootstrap superuser initdb creates — deliberately not the application
# role. Operators use it for backups and the audit-chain bootstrap. REQUIRED.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me

# Blank means the `db` container.
DATABASE_HOST=

# Loopback port PostgreSQL is published on (127.0.0.1 only). The scanner
# worker, which uses host networking, connects through it. Use 5433 if a
# PostgreSQL on the host already owns 5432.
POSTGRES_PORT_BINDING=5432

# Loopback port Redis is published on, for the same reason: the scanner worker
# reaches it at 127.0.0.1. Change it only if something else owns 6379 (or for an
# isolated rehearsal beside a running stack); the worker follows it.
#REDIS_PORT_BINDING=6379

# TLS from the services to PostgreSQL. The database is reachable only from
# loopback and the Compose network, so TLS is off here. The compose default,
# verify-full, needs a server certificate the fresh database does not have.
# If the port binding is ever widened past 127.0.0.1, turn TLS on first
# (.claude/rules/deployment.md).
PGSSLMODE=disable

# Vulnerability intelligence database. docker-postgres-init.sql creates
# `vuln_intel` owned by VULN_DB_USER, with this password, on first start.
# The password is REQUIRED; there is no fallback.
VULN_DB_HOST=db
VULN_DB_NAME=vuln_intel
VULN_DB_USER=admin
VULN_DB_PASSWORD=change_me

# ── Secrets (REQUIRED: generate per deployment, never commit) ───────────────
# Generate each value with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Encrypts stored MFA (TOTP) secrets. NEVER change it afterwards: every stored
# MFA secret would become undecryptable.
MFA_ENCRYPTION_KEY=generate_me_see_comment_above

# Encrypts stored scan credentials (SSH, WinRM, SNMP, database). The api,
# workers and beat all receive this one value; a host script that decrypts
# stored credentials needs the same value in Backend/.env. Changing it makes
# stored credentials unreadable: re-enter them afterwards.
COMPLIANCE_ENCRYPTION_KEY=generate_me_see_comment_above

# ── Token signing keys ───────────────────────────────────────────────────────
# Host directory holding keyset.json and the private key files, mounted
# read-only into the api container only. REQUIRED. Keep it OUTSIDE the
# repository, mode 711, with each private key owned by uid 1000 (the container
# user) and mode 600. Create it with Backend/scripts/security/manage_token_keys.py;
# README.md, "Create the token signing key", gives the command. Tokens are
# ES256 only: there is no HS256 mode and no JWT secret.
CCURE_TOKEN_KEYS_HOST_DIR=/home/<deploy-user>/ccure-keys

# ── Organisation and first administrator ─────────────────────────────────────
# The default organisation. The api creates it on its first start and finds it
# again on every later one by its id, org_<slug>. REQUIRED. On an existing
# installation these must name the organisation it already has: a slug that
# matches none creates a second organisation.
DEFAULT_ORG_NAME=Example Organisation
DEFAULT_ORG_SLUG=example

# The first administrator, created on the api's first start while the database
# has no users at all; ignored on every start after that, so an existing
# account is never changed. Set both for a new installation, then remove the
# password from this file once you have signed in (the api holds it in its
# environment for as long as it is set here). Without them no administrator is
# created and README.md, "What the first start does", gives the alternative.
#DEFAULT_ADMIN_EMAIL=admin@example.com
#DEFAULT_ADMIN_PASSWORD=change_me

# ── Web access ───────────────────────────────────────────────────────────────
# The frontend calls the API under /api on its own origin. Keep /api: the value
# is baked into the bundle at build time, and the Content-Security-Policy
# blocks any other origin.
VITE_API_BASE_URL=/api

# Browser origins the API accepts. Add the HTTPS address users reach the
# application on, for example https://<server-address>; list only addresses
# that resolve. The local entries below suit a single-machine trial.
CORS_ALLOW_ORIGINS=http://localhost:3200,http://127.0.0.1:3200,http://localhost:3000,http://127.0.0.1:3000

# Address used in links the application emails (verification, password reset).
# Set it to the address users reach, for example https://<server-address>.
FRONTEND_URL=http://127.0.0.1:3200

# Refresh-token cookie. Set True when the application is served over HTTPS.
# Over plain HTTP from another machine the browser refuses a Secure cookie and
# every session ends when the 30-minute access token expires.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
#REFRESH_COOKIE_PATH=/

# Self-registration default (true/false). Administration > User Management >
# Registration settings can save an override; "Use deployment default" follows
# this flag again. Recreate the api after changing it.
ALLOW_SELF_REGISTRATION=false

# ── Mail (verification and password-reset messages) ──────────────────────────
# The mail server the containers use. For Gmail, SMTP_PASSWORD is an app
# password, not the account password. It is a live send-as credential for the
# account named below: never commit it. (Backend/.env.example's SMTP values
# point at a local test mail catcher and apply only to a backend run on the
# host.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=change_me
SMTP_SECURE=True
SMTP_FROM_EMAIL=no-reply@example.com

# ── Task execution and scanner capacity ──────────────────────────────────────
# False: tasks run on the Celery workers. True runs each task inside the
# process that queued it (the compose default), which is meant only for tests.
CELERY_TASK_ALWAYS_EAGER=False

# Optional, compose defaults shown: scanner worker concurrency, the global Nmap
# process cap and threads, web-scan worker concurrency and request rate.
#SCANNER_WORKER_CONCURRENCY=20
#MAX_NMAP_PROCESSES=20
#NMAP_THREADS=20
#WEB_WORKER_CONCURRENCY=4
#WEB_SCAN_RATE_LIMIT=10

# ── Optional secrets, each passed only to the service that uses it ───────────
# NVD API key for the api's daily incremental NVD sync (faster rate limits;
# unset works, more slowly).
#NVD_API_KEY=
# Bearer token for a self-hosted OAST collaborator (web-worker only).
#OAST_TOKEN=

# =========================================================================
# Optional application settings. docker-compose.yml forwards each of these
# (x-app-settings) to api, worker, beat and web-worker; unset, the code default
# shown applies. The explanation of each is in Backend/.env.example or the
# rule file named.
# =========================================================================

# ── Logging ──
#LOG_LEVEL=INFO
#LOG_FORMAT=text
#ACCESS_LOG_LEVEL=WARNING

# ── Sessions and tokens ──
#ACCESS_TOKEN_EXPIRES_MINUTES=30
#REFRESH_TOKEN_EXPIRES_DAYS=7
#REFRESH_COOKIE_NAME=ccure_refresh_token
# Unset means a host-only cookie.
#REFRESH_COOKIE_DOMAIN=
#REFRESH_SESSION_RETENTION_DAYS=90
#RBAC_REAUTH_MODE=enforce

# ── Rate limits (.claude/rules/api-security.md) ──
#API_DEFAULT_RATE_LIMIT=600/minute
#API_RATE_LIMIT_EXEMPT_PATHS=/,/docs*,/redoc*,/openapi.json
#RATE_LIMIT_MEMORY_FALLBACK=20/minute
#PASSWORD_RESET_IP_HOURLY_LIMIT=20
#PASSWORD_RESET_ACCOUNT_HOURLY_LIMIT=5
#REGISTRATION_DAILY_IP_LIMIT=10

# ── Registration and email-domain screening ──
#SELF_REGISTRATION_AUTO_APPROVE=False
#EMAIL_VERIFICATION_TTL_HOURS=24
#UNVERIFIED_ACCOUNT_TTL_DAYS=7
#UNAPPROVED_ACCOUNT_TTL_DAYS=30
#PENDING_APPROVAL_QUEUE_LIMIT=200
#EMAIL_DOMAIN_GUARD_MODE=enforce
#EMAIL_DOMAIN_CACHE_TTL_SECONDS=300
#EMAIL_RISK_ENRICHMENT_ENABLED=True
#EMAIL_RISK_DNS_TIMEOUT=3
#EMAIL_RISK_RDAP_TIMEOUT=5
#EMAIL_RISK_MIN_DOMAIN_AGE_DAYS=90
#DISPOSABLE_SYNC_MIN_ROWS_PER_SOURCE=500
#DISPOSABLE_RETIRE_AFTER_MISSES=3

# ── Scan authorisation, deadlines and depth ──
# True: an organisation with no configured scan scope cannot scan at all.
#REQUIRE_SCAN_SCOPE=False
#SCAN_ALLOW_INTRUSIVE=False
# Comma-separated addresses or CIDRs no scan may target. Unset: none.
#SCAN_IP_BLACKLIST=
# Per-phase soft time limits in seconds; the hard limit is the soft one plus
# the margin (.claude/rules/scan-lifecycle.md).
#SCAN_TIME_LIMIT_DISCOVERY=1800
#SCAN_TIME_LIMIT_PORT_SCAN=7200
#SCAN_TIME_LIMIT_VULN_AUDIT=14400
#SCAN_TIME_LIMIT_CREDENTIALED=7200
#SCAN_TIME_LIMIT_TOPOLOGY=1800
#SCAN_TIME_LIMIT_HARD_MARGIN=300
#SCAN_STALL_TIMEOUT_MINUTES=90
#SCAN_QUEUE_TIMEOUT_MINUTES=15
#NMAP_TIMEOUT=300
#NMAP_PROCESS_WAIT_TIMEOUT=900
#TLS_DEEP_SCAN=1
#TLS_DEEP_MAX_ENDPOINTS=4
#TLS_STARTTLS_SCAN=1

# ── Nuclei ──
# NUCLEI_TIMEOUT and NUCLEI_CONCURRENCY have two code defaults: the network
# scan's Nuclei probe uses 900 s and 50, web application scanning 7200 s and
# 25. Setting either applies the value to both.
#NUCLEI_SEVERITIES=critical,high,medium
#NUCLEI_TIMEOUT=
#NUCLEI_RATE_LIMIT=150
#NUCLEI_CONCURRENCY=
#NUCLEI_CONCURRENCY_FAST=75
#NUCLEI_TIMEOUT_FAST=1800
#NUCLEI_CONCURRENCY_DEEP=40
#NUCLEI_TIMEOUT_DEEP=14400
#NUCLEI_RATE_FAST=150
#NUCLEI_RATE_STANDARD=150
#NUCLEI_RATE_DEEP=100
#NUCLEI_EXCLUDE_TAGS=dos,fuzz,intrusive,brute-force
#NUCLEI_INCLUDE_DANGEROUS_TAGS=False

# ── Web application scanning ──
#WEB_SCAN_TIMEOUT=14400
#WEB_SCAN_QUEUE_TIMEOUT_MINUTES=15
#CRAWL_CONCURRENCY=3
#CRAWL_RATE_LIMIT=10
#MAX_CRAWL_URLS=500
#MAX_CRAWL_DEPTH=5
#PLAYWRIGHT_TIMEOUT=60000
#CRAWL_SETTLE_TIMEOUT=5000
#FFUF_SMALL_MAX_ENDPOINTS=5
#FFUF_MEDIUM_MAX_ENDPOINTS=50
#FFUF_MAX_WORDS_SMALL=0
#FFUF_MAX_WORDS_STANDARD=0
#FFUF_MAX_WORDS_DEEP=0
# Out-of-band testing. Unset server, domain and URL: no active OAST probing.
#OAST_ENABLED=True
#OAST_ACTIVE_PROBES=True
#OAST_SERVER=
#OAST_DOMAIN=
#OAST_HTTP_URL=
#OAST_POLL_TIMEOUT_S=30
#OAST_POLL_INTERVAL_S=2
#OAST_RATE_LIMIT=5
#OAST_MAX_TARGETS=25
#OAST_RECEIVER_HTTP_PORT=0
#OAST_RECEIVER_DNS_PORT=0

# ── Compliance, evidence uploads and malware scanning (.claude/rules/uploads.md) ──
# Unset: the shipped list in Backend/core/compliance_frameworks.py.
#COMPLIANCE_ACTIVE_FRAMEWORKS=
#COMPLIANCE_EVIDENCE_TENANT_QUOTA_BYTES=2147483648
# Set CLAMAV_HOST=clamav after `docker compose --profile av up -d clamav`.
# Unset: no scan, and uploads report malware_scan: not_configured. Once it is
# set, UPLOAD_AV_REQUIRED defaults to True (an unreachable scanner refuses the
# upload); set it to False only while clamd is being brought up.
#CLAMAV_HOST=
#CLAMAV_PORT=3310
#CLAMAV_TIMEOUT=30
#UPLOAD_AV_REQUIRED=

# ── Audit log (.claude/rules/audit-retention.md) ──
#AUDIT_EXPORT_MAX_ROWS=50000
#AUDIT_EXPORT_PAGE_SIZE=1000
#AUDIT_EXPORT_PDF_MAX_ROWS=5000
# Retention is off at 0, the shipped state. Do not enable it without the
# retention period agreed with the compliance owner and the DBA bootstrap.
#AUDIT_LOG_RETENTION_DAYS=0
#AUDIT_RETENTION_MIN_DAYS=90
#AUDIT_RETENTION_BATCH_SIZE=1000
#AUDIT_RETENTION_MAX_ROWS_PER_RUN=50000
#AUDIT_RETENTION_DRY_RUN=True
#AUDIT_RETENTION_REQUIRE_BACKUP_HOURS=24
