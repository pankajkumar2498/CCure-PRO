{
  "$defs": {
    "AssessmentKind": {
      "description": "The kind of Audit assessment a result describes.",
      "enum": [
        "network",
        "asset_discovery",
        "vulnerability_audit",
        "credentialed",
        "compliance",
        "web_application"
      ],
      "title": "AssessmentKind",
      "type": "string"
    },
    "AssessmentMethod": {
      "description": "The assessment methods Audit applies to an asset.",
      "enum": [
        "discovery",
        "port_scan",
        "network_checks",
        "credentialed_access",
        "package_vulnerability",
        "configuration_audit",
        "web_application",
        "malware_scan"
      ],
      "title": "AssessmentMethod",
      "type": "string"
    },
    "AssessmentOrigin": {
      "enum": [
        "manual",
        "schedule",
        "integration_request"
      ],
      "title": "AssessmentOrigin",
      "type": "string"
    },
    "AssessmentStatus": {
      "description": "How an assessment ended. Only terminal assessments produce a result.",
      "enum": [
        "completed",
        "completed_with_errors",
        "failed",
        "cancelled"
      ],
      "title": "AssessmentStatus",
      "type": "string"
    },
    "CcureAssessmentDescriptorV1": {
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "allOf": [
            {
              "$ref": "#/$defs/CcureAssessmentRefV1"
            }
          ],
          "description": "Identity and completion time.",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/CcureBaselineRefV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The Policy Pro baseline in force, if any.",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "kind": {
          "allOf": [
            {
              "$ref": "#/$defs/AssessmentKind"
            }
          ],
          "description": "What kind of assessment.",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "origin": {
          "allOf": [
            {
              "$ref": "#/$defs/AssessmentOrigin"
            }
          ],
          "description": "What started it.",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "scan_policy_name": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of the scan policy, if one was chosen.",
          "title": "Scan Policy Name",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "started_at": {
          "description": "Start.",
          "format": "date-time",
          "title": "Started At",
          "type": "string",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "status": {
          "allOf": [
            {
              "$ref": "#/$defs/AssessmentStatus"
            }
          ],
          "description": "How it ended.",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "status_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why, unless completed.",
          "title": "Status Reason",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        }
      },
      "required": [
        "assessment",
        "kind",
        "status",
        "origin",
        "started_at"
      ],
      "title": "CcureAssessmentDescriptorV1",
      "type": "object"
    },
    "CcureAssessmentRefV1": {
      "additionalProperties": false,
      "description": "An Audit assessment (a scan or a compliance run).",
      "properties": {
        "assessment_id": {
          "description": "Audit's assessment identifier. Opaque.",
          "maxLength": 400,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]*$",
          "title": "Assessment Id",
          "type": "string",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When the assessment reached its terminal state.",
          "title": "Completed At",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "scan_policy_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fingerprint of the scan policy snapshot the assessment ran under (GAP-12). Two results with different fingerprints assessed different things and are not directly comparable.",
          "title": "Scan Policy Fingerprint",
          "x-ccure-availability": "partial",
          "x-ccure-owner": "audit"
        }
      },
      "required": [
        "assessment_id"
      ],
      "title": "CcureAssessmentRefV1",
      "type": "object"
    },
    "CcureAssessmentResultDataV1": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "description": "Every discovered asset, with its coverage.",
          "items": {
            "$ref": "#/$defs/CcureAssetAssessmentV1"
          },
          "title": "Assets",
          "type": "array",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "content_sha256": {
          "description": "Digest of the canonical JSON of this data object without this field.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "control_result_count": {
          "description": "Control results in the controls pages.",
          "minimum": 0,
          "title": "Control Result Count",
          "type": "integer",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "coverage": {
          "allOf": [
            {
              "$ref": "#/$defs/CcureCoverageCountsV1"
            }
          ],
          "description": "What was covered.",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "descriptor": {
          "allOf": [
            {
              "$ref": "#/$defs/CcureAssessmentDescriptorV1"
            }
          ],
          "description": "The assessment.",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "finding_count": {
          "description": "Findings in the findings pages (all detected by this assessment).",
          "minimum": 0,
          "title": "Finding Count",
          "type": "integer",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "findings": {
          "allOf": [
            {
              "$ref": "#/$defs/CcureFindingTotalsV1"
            }
          ],
          "description": "Finding totals.",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "frameworks": {
          "description": "Per-framework control summaries.",
          "items": {
            "$ref": "#/$defs/CcureFrameworkSummaryV1"
          },
          "title": "Frameworks",
          "type": "array",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "metrics": {
          "allOf": [
            {
              "$ref": "#/$defs/CcureProgrammeMetricsV1"
            }
          ],
          "description": "Programme KPIs.",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "result_id": {
          "description": "Identifier of this immutable result.",
          "maxLength": 400,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]*$",
          "title": "Result Id",
          "type": "string",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        }
      },
      "required": [
        "result_id",
        "content_sha256",
        "descriptor",
        "coverage",
        "assets",
        "findings",
        "finding_count",
        "control_result_count",
        "metrics"
      ],
      "title": "CcureAssessmentResultDataV1",
      "type": "object"
    },
    "CcureAssetAssessmentV1": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "allOf": [
            {
              "$ref": "#/$defs/CcureAssetRefV1"
            }
          ],
          "description": "The asset.",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "coverage": {
          "allOf": [
            {
              "$ref": "#/$defs/CoverageState"
            }
          ],
          "description": "How completely the asset was assessed. ASSESSED only when every method the scan's policy selected completed.",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "coverage_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why, unless ASSESSED.",
          "title": "Coverage Reason",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "credentialed": {
          "anyOf": [
            {
              "$ref": "#/$defs/CcureCredentialedAccessV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The authenticated session. null when no credential was in scope for this asset — which is different from a refused credential.",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "device_category": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Audit's device classification.",
          "title": "Device Category",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "finding_counts": {
          "anyOf": [
            {
              "$ref": "#/$defs/CcureSeverityCountsV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Open findings by severity. null when the asset was NOT_ASSESSED or ERROR: nothing was learned, which is not zero.",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "methods": {
          "description": "Per-method outcomes.",
          "items": {
            "$ref": "#/$defs/CcureMethodResultV1"
          },
          "title": "Methods",
          "type": "array",
          "x-ccure-availability": "partial",
          "x-ccure-owner": "audit"
        },
        "os": {
          "anyOf": [
            {
              "$ref": "#/$defs/CcureOsV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Operating system, where identified.",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "risk": {
          "allOf": [
            {
              "$ref": "#/$defs/CcureAssetRiskV1"
            }
          ],
          "description": "Risk inputs.",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        }
      },
      "required": [
        "asset",
        "coverage",
        "risk"
      ],
      "title": "CcureAssetAssessmentV1",
      "type": "object"
    },
    "CcureAssetRefV1": {
      "additionalProperties": false,
      "description": "An asset as Audit knows it.\n\n``asset_id`` is Audit's identifier and is opaque. It is **not** stable\nacross a change of IP address today (open question Q5), so the identity\nattributes are carried beside it for correlation by other modules.",
      "properties": {
        "asset_id": {
          "description": "Audit's asset identifier. Opaque.",
          "maxLength": 400,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]*$",
          "title": "Asset Id",
          "type": "string",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "hostname": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hostname, where resolved.",
          "title": "Hostname",
          "x-ccure-availability": "partial",
          "x-ccure-owner": "audit"
        },
        "ip_address": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IPv4 or IPv6 address at assessment time.",
          "title": "Ip Address",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "mac_address": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MAC address, where discovered.",
          "title": "Mac Address",
          "x-ccure-availability": "partial",
          "x-ccure-owner": "audit"
        }
      },
      "required": [
        "asset_id"
      ],
      "title": "CcureAssetRefV1",
      "type": "object"
    },
    "CcureAssetRiskV1": {
      "additionalProperties": false,
      "description": "Asset-level risk inputs (SRS 7.3.7.3, 7.3.7.5).",
      "properties": {
        "asset_criticality": {
          "allOf": [
            {
              "$ref": "#/$defs/CcureMeasuredValueV1"
            }
          ],
          "description": "Business criticality 1–10 (SRS 7.3.7.3). Audit has no criticality attribute yet: not_implemented.",
          "x-ccure-availability": "not_implemented",
          "x-ccure-owner": "audit",
          "x-ccure-srs": [
            "7.3.7.3"
          ]
        },
        "audit_host_risk_score": {
          "allOf": [
            {
              "$ref": "#/$defs/CcureMeasuredValueV1"
            }
          ],
          "description": "Audit's own additive 0–100 host score (core/risk.calculate_risk). It is NOT the SRS weighted risk score.",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "exposure": {
          "allOf": [
            {
              "$ref": "#/$defs/CcureMeasuredValueV1"
            }
          ],
          "description": "Network exposure factor (SRS 7.3.7.5). Not computed yet: not_implemented.",
          "x-ccure-availability": "not_implemented",
          "x-ccure-owner": "audit",
          "x-ccure-srs": [
            "7.3.7.5"
          ]
        },
        "network_zone": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Network segment / Purdue zone (SRS 7.3.1.3). Not modelled yet; always null.",
          "title": "Network Zone",
          "x-ccure-availability": "not_implemented",
          "x-ccure-owner": "audit",
          "x-ccure-srs": [
            "7.3.1.3"
          ]
        }
      },
      "required": [
        "audit_host_risk_score",
        "asset_criticality",
        "exposure"
      ],
      "title": "CcureAssetRiskV1",
      "type": "object"
    },
    "CcureBaselineRefV1": {
      "additionalProperties": false,
      "description": "A specific version of a Policy Pro baseline, as Audit received it.",
      "properties": {
        "baseline_id": {
          "description": "Policy Pro's baseline identifier.",
          "maxLength": 400,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]*$",
          "title": "Baseline Id",
          "type": "string",
          "x-ccure-availability": "available",
          "x-ccure-owner": "policy_pro"
        },
        "baseline_version": {
          "description": "Monotonic version number of the baseline.",
          "minimum": 1,
          "title": "Baseline Version",
          "type": "integer",
          "x-ccure-availability": "available",
          "x-ccure-owner": "policy_pro"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Digest Audit computed over the canonical JSON of the baseline as received. Lets both sides prove which content a result refers to.",
          "title": "Content Sha256",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        }
      },
      "required": [
        "baseline_id",
        "baseline_version"
      ],
      "title": "CcureBaselineRefV1",
      "type": "object"
    },
    "CcureCategoryCountV1": {
      "additionalProperties": false,
      "properties": {
        "counts": {
          "allOf": [
            {
              "$ref": "#/$defs/CcureSeverityCountsV1"
            }
          ],
          "description": "By severity.",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "definition_type": {
          "allOf": [
            {
              "$ref": "#/$defs/DefinitionType"
            }
          ],
          "description": "Finding category.",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        }
      },
      "required": [
        "definition_type",
        "counts"
      ],
      "title": "CcureCategoryCountV1",
      "type": "object"
    },
    "CcureCoverageCountsV1": {
      "additionalProperties": false,
      "properties": {
        "assets_discovered": {
          "description": "Live assets found.",
          "minimum": 0,
          "title": "Assets Discovered",
          "type": "integer",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "assets_targeted": {
          "allOf": [
            {
              "$ref": "#/$defs/CcureMeasuredValueV1"
            }
          ],
          "description": "Addresses the assessment was asked to cover. Available for network scans; a range target's size is known, a hostname list's may not be.",
          "x-ccure-availability": "partial",
          "x-ccure-owner": "audit"
        },
        "by_coverage": {
          "allOf": [
            {
              "$ref": "#/$defs/CcureCoverageStateCountsV1"
            }
          ],
          "description": "Discovered assets per coverage state.",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        }
      },
      "required": [
        "assets_targeted",
        "assets_discovered",
        "by_coverage"
      ],
      "title": "CcureCoverageCountsV1",
      "type": "object"
    },
    "CcureCoverageStateCountsV1": {
      "additionalProperties": false,
      "description": "Assets per coverage state. Every state is present; zero is a real count.",
      "properties": {
        "ASSESSED": {
          "description": "ASSESSED.",
          "minimum": 0,
          "title": "Assessed",
          "type": "integer",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "ERROR": {
          "description": "ERROR.",
          "minimum": 0,
          "title": "Error",
          "type": "integer",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "NOT_ASSESSED": {
          "description": "NOT_ASSESSED.",
          "minimum": 0,
          "title": "Not Assessed",
          "type": "integer",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "PARTIALLY_ASSESSED": {
          "description": "PARTIALLY_ASSESSED.",
          "minimum": 0,
          "title": "Partially Assessed",
          "type": "integer",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        }
      },
      "required": [
        "ASSESSED",
        "PARTIALLY_ASSESSED",
        "NOT_ASSESSED",
        "ERROR"
      ],
      "title": "CcureCoverageStateCountsV1",
      "type": "object"
    },
    "CcureCredentialedAccessV1": {
      "additionalProperties": false,
      "description": "The authenticated session a credentialed assessment ran over.\n\n``outcome`` is the authentication result; coverage is separate\n(``inventory_complete`` here and the asset's method results), because a\nsession that authenticated can still collect only part of what it asked for.",
      "properties": {
        "auth_method": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. password, private_key, ntlm, ntlm_hash.",
          "title": "Auth Method",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "credential_ref": {
          "anyOf": [
            {
              "maxLength": 400,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Audit's credential identifier. Never the secret.",
          "title": "Credential Ref",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "failure_detail": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Operator-facing failure text. Never contains the secret.",
          "title": "Failure Detail",
          "x-ccure-availability": "available",
          "x-ccure-owner": "audit"
        },
        "inventory_complete": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether collection completed. null when not authenticated or not recorded.",
          "title": "Inventory Complete",
          "x-ccure-availability": "partial",
          "x-ccure-owner": "audit"
        },
        "outcome": {
          "allOf": [
            {
              "$ref": "#/$defs/CredentialOutcome"
            }
          ],
          "description": "Authentication result. Audit stores success/failure today; the failure sub-class is available where the transport classified it, otherwise FAILED_UNCLASSIFIED.",
          "x-ccure-availability": "partial",
          "x-ccure-owner": "audit",
          "x-ccure-srs": [
            "7.3.1.10",
            "7.3.6.4"
          ]
        },
        "port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "TCP port.",
