# ── Database Configuration ────────────────────────────────────────────────
POSTGRES_USER=ccure_user
POSTGRES_PASSWORD=ccure_admin_2026
POSTGRES_DB=ccure_test

# Database Host Routing:
# - Leave blank/commented out to use the local containerized PostgreSQL DB (Default for new developers)
# - Set to 'host.docker.internal' to connect to a native PostgreSQL instance running on the Windows host
DATABASE_HOST=

# Database Port Binding on Windows Host:
# - Set to '5432' if you do not have a native PostgreSQL running on Windows (Default for containerized DB)
# - Set to '5433' if you run a native PostgreSQL service on port 5432 to prevent port collisions
POSTGRES_PORT_BINDING=5432

