# =========================================================================
# docker-compose environment. Copy to '.env' (next to docker-compose.yml) and
# fill in every value marked REQUIRED.
#
# This file is TRACKED. Nothing real belongs in it — not a password, not a
# key, not a token. A value committed here is public to everyone who has
# ever cloned the repository, and removing it later does not remove it from
# the history.
#
# Only the variables docker-compose.yml reads belong here: Compose substitutes
# them into the service definitions and passes each one to the services that
# use it. Application settings Compose does not pass (the first administrator,
# feed API tokens, rate limits, log level, ...) belong in Backend/.env, which
# the api container reads; worker, web-worker and beat set SKIP_DOTENV_LOAD=1
# and ignore it. README.md, "Configure the environment", explains both files.
# =========================================================================

# Start the scanner workers (worker, web-worker) with the rest of the stack.
# Without it `docker compose up -d` starts no scanner and scans never run.
COMPOSE_PROFILES=container-scanner

# ── Database (PostgreSQL 18, the `db` service) ──────────────────────────────
# Application role and database. scripts/docker-postgres-init.sql creates the
# role NOSUPERUSER when the data volume is first initialised. REQUIRED.
POSTGRES_USER=ccure_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ccure_db

# The bootstrap superuser initdb creates — deliberately not the application
# role. Operators use it for backups and the audit-chain bootstrap. REQUIRED.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me

# Blank means the `db` container.
DATABASE_HOST=

# Loopback port PostgreSQL is published on (127.0.0.1 only). The scanner
# worker, which uses host networking, connects through it. Use 5433 if a
# PostgreSQL on the host already owns 5432.
POSTGRES_PORT_BINDING=5432

# TLS from the services to PostgreSQL. The database is reachable only from
# loopback and the Compose network, so TLS is off here. The compose default,
# verify-full, needs a server certificate the fresh database does not have.
# If the port binding is ever widened past 127.0.0.1, turn TLS on first
# (CLAUDE.md, "Deployment: Linux VM").
PGSSLMODE=disable

# Vulnerability intelligence database. docker-postgres-init.sql creates
# `vuln_intel` owned by VULN_DB_USER, with this password, on first start.
VULN_DB_HOST=db
VULN_DB_NAME=vuln_intel
VULN_DB_USER=admin
VULN_DB_PASSWORD=change_me

# ── Secrets (REQUIRED: generate per deployment, never commit) ───────────────
# Generate each value with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Encrypts stored MFA (TOTP) secrets. NEVER change it afterwards: every stored
# MFA secret would become undecryptable.
MFA_ENCRYPTION_KEY=generate_me_see_comment_above

# Encrypts stored scan credentials (SSH, WinRM, SNMP, database). The api,
# workers and beat all receive this one value. Changing it makes stored
# credentials unreadable: re-enter them afterwards.
COMPLIANCE_ENCRYPTION_KEY=generate_me_see_comment_above

# ── Token signing keys ───────────────────────────────────────────────────────
# Host directory holding keyset.json and the private key files, mounted
# read-only into the api container only. REQUIRED. Keep it OUTSIDE the
# repository, mode 711, with each private key owned by uid 1000 (the container
# user) and mode 600. Create it with Backend/scripts/security/manage_token_keys.py;
# README.md, "Create the token signing key", gives the command. Tokens are
# ES256 only: there is no HS256 mode and no JWT secret.
CCURE_TOKEN_KEYS_HOST_DIR=/home/<deploy-user>/ccure-keys

# ── Web access ───────────────────────────────────────────────────────────────
# The frontend calls the API under /api on its own origin. Keep /api: the value
# is baked into the bundle at build time, and the Content-Security-Policy
# blocks any other origin.
VITE_API_BASE_URL=/api

# Browser origins the API accepts. Add the HTTPS address users reach the
# application on.
CORS_ALLOW_ORIGINS=http://localhost:3200,http://127.0.0.1:3200,http://localhost:3000,http://127.0.0.1:3000

# Address used in links the application emails (verification, password reset).
FRONTEND_URL=http://127.0.0.1:3200

# Refresh-token cookie. Set True when the application is served over HTTPS.
# Over plain HTTP from another machine the browser refuses a Secure cookie and
# every session ends when the 30-minute access token expires.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# Self-registration default (true/false). Administration > User Management >
# Registration settings can save an override; "Use deployment default" follows
# this flag again. Recreate the api after changing it.
ALLOW_SELF_REGISTRATION=false

# ── Mail (verification and password-reset messages) ──────────────────────────
# For Gmail, SMTP_PASSWORD is an app password, not the account password. It is
# a live send-as credential for the account named below: never commit it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=change_me
SMTP_SECURE=True
SMTP_FROM_EMAIL=no-reply@example.com

# ── Task execution and scanner limits ────────────────────────────────────────
# False: tasks run on the Celery workers. True runs each task inside the
# process that queued it (the compose default), which is meant only for tests.
CELERY_TASK_ALWAYS_EAGER=False

# Optional, compose defaults shown: scanner worker concurrency, the global Nmap
# process cap and threads, web-scan worker concurrency and request rate.
#SCANNER_WORKER_CONCURRENCY=20
#MAX_NMAP_PROCESSES=20
#NMAP_THREADS=20
#WEB_WORKER_CONCURRENCY=4
#WEB_SCAN_RATE_LIMIT=10
