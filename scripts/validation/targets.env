# Disposable, isolated scan targets for live validation.
# docs/ci/LIVE_SCAN_VALIDATION.md says how they are used and why each exists.
#
# One definition, read by targets.sh and live_scan.sh (sourced) and by
# tests/repo/test_live_scan_tooling.py (parsed). KEY=VALUE, no spaces around
# '=', double quotes for lists. Images are pinned by digest so a target is the
# same software every time it is created; the SSH target installs openssh-server
# from the Ubuntu archive at build time, so its OpenSSH build can move when the
# image is rebuilt (targets.sh keeps the built image between runs).

# The network is --internal: no route off the host, nothing published.
VALIDATION_NETWORK="ccure-validation-targets"
VALIDATION_SUBNET="172.30.250.0/24"
# Docker gives the host this address on the bridge, internal or not. It is the
# VM itself, so it is never a target: live_scan.sh excludes it from every scan.
VALIDATION_HOST_ADDRESS="172.30.250.1"
VALIDATION_SCANNER_ADDRESS="172.30.250.5"
VALIDATION_PROBE_ADDRESS="172.30.250.6"

# The targets. Each exercises a different part of an unauthenticated scan.
SSH_TARGET="172.30.250.10"     # OpenSSH banner and version, ssh_probe
WEB_TARGET="172.30.250.11"     # nginx serving a dummy .env and .git/config: Nuclei, HTTP checks
REDIS_TARGET="172.30.250.12"   # Redis with no authentication: a critical network check
PG_TARGET="172.30.250.13"      # PostgreSQL: service detection, default-credential probing
EMPTY_ADDRESSES="172.30.250.14 172.30.250.15"   # must stay inactive

SSH_CONTAINER="ccure-validation-ssh"
WEB_CONTAINER="ccure-validation-web"
REDIS_CONTAINER="ccure-validation-redis"
PG_CONTAINER="ccure-validation-pg"

SSH_BASE_IMAGE="ubuntu@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac"
SSH_IMAGE_TAG="ccure-validation-ssh:ubuntu-24.04"
WEB_IMAGE="nginx@sha256:985220252f3863977e468f611ef118ebd01421289dd86ee1ae99cb068c3bce2b"
REDIS_IMAGE="redis@sha256:ff02b58f971e7d7d156a1267e283fcbbeee91773b6aa36c49dac28ecfe28eadf"
PG_IMAGE="postgres@sha256:d3e1620b530c944afa6e887d22eb899824da68e19c52024bf98f5220c88a65b2"
PROBE_IMAGE="busybox@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662"
